ENVIRONMENT=dev
DATABASE_URL=sqlite:///./assessment.db
# JWT_SECRET=change-me-long-random   (required when ENVIRONMENT=prod)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345
CORS_ORIGINS=http://localhost:8000
COOKIE_SECURE=false
JUDGE0_URL=http://localhost:2358

# ---- production (docker compose) ----
# JWT_SECRET=<python -c "import secrets;print(secrets.token_urlsafe(48))">
# POSTGRES_PASSWORD=<strong password>
# JUDGE0_AUTH_TOKEN=<same as AUTHN_TOKEN in deploy/judge0.conf>
# PUBLIC_ORIGIN=https://assess.yourcollege.edu
# WEB_CONCURRENCY=4

# ---- email: invitations and password reset (console = print to the server log, nothing is sent)
MAIL_BACKEND=console
PUBLIC_URL=http://localhost:8000
# MAIL_BACKEND=smtp
# SMTP_HOST=smtp.yourcollege.edu
# SMTP_PORT=587
# SMTP_USER=assessment@yourcollege.edu
# SMTP_PASSWORD=<app password>
# MAIL_FROM=Stradit Assessment <assessment@yourcollege.edu>
